<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="GlassNGo est une boutique en ligne spécialisée dans les lunettes et accessoires optiques, avec un programme d’opticiens et des produits de qualité.">
        <meta name="keywords" content="opticien, lunettes, boutique en ligne, accessoires optiques, GlassNGo">
        <meta name="robots" content="index, follow">
        <meta property="og:title" content="GlassNGo | Boutique optique en ligne">
        <meta property="og:description" content="Découvrez une sélection de lunettes et accessoires optiques sur GlassNGo.">
        <meta property="og:type" content="website">
        <meta name="theme-color" content="#95b0a6">
        <title>{% block title %}GlassNGo | Boutique optique en ligne{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%221.3em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/style.css') }}?v={{ 'now'|date('YmdHis') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="{{ asset('fonction.js') }}"></script>
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
    </body>
</html>
