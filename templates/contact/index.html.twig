{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    {{ include('header.html.twig') }}

    {% for message in app.flashes('success') %}<div class="alert alert-success" role="status">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert alert-danger" role="alert">{{ message }}</div>{% endfor %}
    {{ message_fonctionnel }}
    <h1 class="page-title">Contact</h1> 
    <main class="page-container" id="page_contact">
            
            
            {{ form_start(form, {'action': path('app_contact_submit'), 'attr': {'class': 'contact-form'}}) }}
                {{ form_row(form.identifiant_user) }}
                {{ form_row(form.email_user) }}
                {{ form_row(form.message) }}
                <button type="submit" class="btn btn-primary">Envoyer</button>
            {{ form_end(form) }}
           
        <div class="infos_vendeur">
        <h2>Contacts</h2>
            <ul>
                <li>Notre équipe est disponible à tout moment</li>
                <li>02 12 34 56 78</li>
                <li>contact@glassNGo.com</li>
            </ul>
            <img src="/logo.png" alt="image_illustration_vendeur">
        </div>
        
    </main>
     {{ include('footer.html.twig') }}
{% endblock %}
