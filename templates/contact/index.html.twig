{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
    {{ include('header.html.twig') }}

    {{ message_fonctionnel }}
    <h1 class="page-title">Contact</h1> 
    <main class="page-container" id="page_contact">
            
            
            {{ form_start(form, {'action': path('app_contact_submit'), 'attr': {'class': 'contact-form'}}) }}
                {{ form_row(form.identifiant_user) }}
                {{ form_row(form.email_user) }}
                {{ form_row(form.message) }}
                <button type="submit" class="btn btn-primary">Envoyer</button>
            {{ form_end(form) }}
           
        <div class="infos_vendeur">
        <h2>Titre</h2>
            <ul>
                <li>Abracadabra</li>
                <li>Bobidibou</li>
                <li>Clapipatop</li>
            </ul>
            <img src="https://placehold.co/200x200" alt="image_illustration_vendeur">
        </div>
        
    </main>
{% endblock %}
