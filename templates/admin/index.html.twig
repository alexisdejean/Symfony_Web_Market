{% extends 'base.html.twig' %}

{% block title %}Admin Panel{% endblock %}

{% block body %}
 {{ include('header.html.twig') }}


<div class="admin-panel">
    <h1>Bienvenue sur votre panel d'administration</h1>
        <div class="actions_admins">
            <p>Vous pouvez gérer les produits, les utilisateurs et d'autres aspects de votre site web à partir de ce panneau.</p>
            <ul>
                <li><a href="{{ path('app_service') }}">Gérer les produits</a></li>
                <li><a href="{{ path('app_gestion_user') }}">Gérer les utilisateurs</a></li>
                {# Ajoutez d'autres liens vers des fonctionnalités d'administration ici #} 
            </ul>
        </div>
        <div class="contact_messages">
            <h2>Messages de contact</h2>
            <ul>
                {% for message in contact_messages %}
                    <li>
                        <strong>{{ message.identifiantUser }} ({{ message.emailUser }})</strong><br>
                        {{ message.message }}<br>
                        <em>Envoyé le {{ message.dateEnvoi|date('d/m/Y H:i') }}</em>
                    </li>
                {% else %}
                    <li>Aucun message de contact pour le moment.</li>
                {% endfor %}
            </ul>
        
</div>
{% endblock %}
