{% extends 'base.html.twig' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
    {{ include('header.html.twig') }}

    <main class="page-container">
        <h1>{{ page_title }}</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom, {'value': form.nom.vars.value ?: 'Non défini'}) }}     
            {{ form_row(form.prenom, {'value': form.prenom.vars.value ?: 'Non défini'}) }}   
            {{ form_row(form.role) }}
            <button type="submit">{{ button_label }}</button>
        {{ form_end(form) }}
    </main>
{% endblock %}
