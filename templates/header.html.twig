
<header class="site-header">
    <div class="logo"><img src="/logo.png" alt="Logo" style="max-height: 50px; width: auto;"></div>

    <nav>
        <ul class="menu">
            <li class="sousmenu"><a href="{{ path('home_page') }}">Accueil</a></li>
            <li class="sousmenu"><a href="{{ path('about_page') }}">À propos</a></li>
            <li class="sousmenu"><a href="{{ path('services_page') }}">Services</a></li>
            <li class="sousmenu"><a href="{{ path('contact_page') }}">Contact</a></li>
        </ul>
