
<header class="site-header">
    <a href="{{ path('home_page') }}" class="logo" aria-label="Accueil">
        <img src="/logo.png" alt="Logo">
    </a>

    <nav>
        <ul class="menu">
            <li class="sousmenu"><a href="{{ path('home_page') }}">Accueil</a></li>
            {# Afficher "À propos" uniquement si l'utilisateur a le rôle USER ou ADMIN #}
            {% if not app.user %}
            <li class="sousmenu"><a href="{{ path('about_page') }}">À propos</a></li>
            {% endif %}
            
            {% if not app.user or (is_granted('ROLE_USER')) %}
            <li class="sousmenu"><a href="{{ path('contact_page') }}">Contact</a></li>
            <li class="sousmenu"><a href="{{ path('services_page') }}">Produits</a></li>
            {% endif %}
            {% if app.user and is_granted('ROLE_USER') %}
                <li class="sousmenu"><a href="{{ path('app_panier') }}">Panier</a></li>
            {% endif %}
            {% if app.user and is_granted('ROLE_ADMIN') %}
                <li class="sousmenu"><a href="{{ path('app_admin') }}">Admin</a></li>
            {% endif %}
            
            
        </ul>
    </nav>

    <div class="header-actions">
        {% if app.user %}
            <a class="btn-client" href="{{ path('app_reglages', {'id_compte': app.user.id}) }}">Réglages</a>
        {% else %}
            <a class="btn-client" href="{{ path('login_page') }}">Connexion</a>
        {% endif %}   
    </div>
</header>